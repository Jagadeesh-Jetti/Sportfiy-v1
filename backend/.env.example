# Copy this file to .env and fill in real values. DO NOT commit .env.

# Postgres connection string (Neon, Supabase, local — anything Prisma can talk to).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT signing secret. Must be at least 32 chars.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT=5000
NODE_ENV=development

# Frontend origin allowed by CORS (comma-separate for multiple).
CORS_ORIGIN="http://localhost:5173"
